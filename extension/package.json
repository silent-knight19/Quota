		"configuration": {
			"title": "Quota",
			"properties": {
				"quota.pythonPath": {
					"type": "string",
					"default": "",
					"description": "Custom path to Python 3 binary (leave empty to use system default python3/python)"
				},
				"quota.statusBarMode": {
					"type": "string",
					"default": "session",
					"enum": [
						"session",
						"workspace",
						"total"
					],
					"enumDescriptions": [
						"Show active chat session token and cost metrics",
						"Show current workspace repository metrics",
						"Show lifetime cumulative global metrics"
					],
					"description": "Metric scope displayed in the IDE bottom status bar"
				},
				"quota.dataDirectory": {
					"type": "string",
					"default": "",
					"description": "Custom directory path for persistent SQLite ledger (leave empty for ~/.config/quota)"
				}
			}
		}
